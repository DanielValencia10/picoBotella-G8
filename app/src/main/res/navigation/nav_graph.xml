<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/instrucciones_fragment">

    <fragment
        android:id="@+id/splash_fragment"
        android:name="com.equipo8.picobotella.ui.splash.SplashFragment"
        android:label="SplashFragment"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/home_fragment"
            app:popUpTo="@id/splash_fragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/home_fragment"
        android:name="com.equipo8.picobotella.ui.home.HomeFragment"
        android:label="HomeFragment"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_instrucciones"
            app:destination="@id/instrucciones_fragment" />
        <action
            android:id="@+id/action_home_to_retos"
            app:destination="@id/retos_fragment" />
        <action
            android:id="@+id/action_home_to_compartir"
            app:destination="@id/compartir_fragment" />
    </fragment>

    <fragment
        android:id="@+id/instrucciones_fragment"
        android:name="com.equipo8.picobotella.ui.instrucciones.InstruccionesFragment"
        android:label="InstruccionesFragment"
        tools:layout="@layout/fragment_instrucciones" />

    <fragment
        android:id="@+id/retos_fragment"
        android:name="com.equipo8.picobotella.ui.retos.RetosFragment"
        android:label="RetosFragment"
        tools:layout="@layout/fragment_retos" />

    <fragment
        android:id="@+id/compartir_fragment"
        android:name="com.equipo8.picobotella.ui.compartir.CompartirFragment"
        android:label="CompartirFragment"
        tools:layout="@layout/fragment_compartir" />

</navigation>
